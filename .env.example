# Credentials for the local S3 model store (RustFS); pick your own values
S3_ACCESS_KEY=modelstore
S3_SECRET_KEY=change-me-please
S3_BUCKET=models

# Model to serve. s3:// paths stream from the model store; Hugging Face ids and local paths also work.
# On a 12 GB GPU, prefer AWQ/GPTQ-quantized ~7-8B models or unquantized models up to ~3B.
MODEL=s3://models/Qwen/Qwen2.5-0.5B-Instruct

# Used only by the seed step, for gated models (e.g. Llama)
HF_TOKEN=

# Cap context length to fit the KV cache in VRAM
MAX_MODEL_LEN=8192

GPU_MEMORY_UTILIZATION=0.90

# Optional: name exposed by /v1/models (defaults to MODEL)
SERVED_MODEL_NAME=

# Optional: require "Authorization: Bearer <key>" on requests
VLLM_API_KEY=

# Optional: any other `vllm serve` flags, e.g. --enable-prefix-caching
EXTRA_ARGS=

# Optional: host ports (defaults 8000, 9000, 9001)
API_PORT=
S3_PORT=
S3_CONSOLE_PORT=
